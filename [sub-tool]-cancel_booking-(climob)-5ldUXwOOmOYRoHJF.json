{"updatedAt":"2026-07-19T15:38:54.595Z","createdAt":"2026-07-11T15:46:16.524Z","id":"5ldUXwOOmOYRoHJF","name":"[Sub Tool] cancel_booking (CLImob)","active":false,"isArchived":false,"nodes":[{"parameters":{},"id":"a517b755-510d-42f6-b58a-0332b5a05c62","name":"Execute Workflow Trigger","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[0,0]},{"parameters":{},"id":"bce79852-d3b2-4328-8ca9-fdc673392a3a","name":"When clicking 'Test'","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,304]},{"parameters":{"assignments":{"assignments":[{"id":"a1","name":"airtable_record_id","value":"recXXXXXXXXXXXXXX","type":"string"},{"id":"a2","name":"cancellation_reason","value":"Teste do sub-tool cancel_booking (CLImob)","type":"string"}]},"options":{}},"id":"b1ae0577-4f5a-42dd-8a88-c0a1b1ed2b87","name":"Set Test Input","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[224,304]},{"parameters":{"url":"=https://api.airtable.com/v0/appeFkj0KrO6svhbt/tblcMxt4kltZgTSjM/{{ $json.airtable_record_id }}","authentication":"***REDACTED***","nodeCredentialType":"airtableTokenApi","options":{}},"id":"4062e380-1c3c-45e4-b88e-2da8bb65567b","name":"Get Lead from Airtable","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[448,0],"credentials":null},{"parameters":{"jsCode":"const lead = $input.item.json;\nconst fields = lead.fields || {};\nconst cancelUrl = fields.calendly_cancel_url || '';\nconst airtable_record_id = lead.id;\n\nlet cancellation_reason = '';\ntry {\n  cancellation_reason = $('Set Test Input').item.json.cancellation_reason || '';\n} catch (e) {\n  try {\n    cancellation_reason = $('Execute Workflow Trigger').item.json.cancellation_reason || '';\n  } catch (e2) {\n    cancellation_reason = '';\n  }\n}\n\nif (!cancelUrl || cancelUrl.trim() === '') {\n  return [{\n    json: {\n      airtable_record_id,\n      has_booking: false,\n      calendly_uuid: null,\n      cancellation_reason,\n      skip_cancel: true,\n      message: 'Lead nao tem booking ativo para cancelar.'\n    }\n  }];\n}\n\n// Extrai o ultimo UUID presente no calendly_cancel_url — robusto a diferentes\n// convencoes de path do Calendly (cancellations/{uuid}, events/{uuid}, etc.).\n// ATENCAO: validar com um registo real antes de confiar em producao — o cancel_url\n// hospedado do Calendly pode conter o UUID do INVITEE, nao o do SCHEDULED EVENT;\n// se a chamada abaixo devolver 404/nao encontrado, este e o ponto a rever.\nconst uuidMatches = cancelUrl.match(/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/gi);\nif (!uuidMatches || uuidMatches.length === 0) {\n  throw new Error(`calendly_cancel_url nao contem um UUID reconhecivel: ${cancelUrl}`);\n}\nconst calendly_uuid = uuidMatches[uuidMatches.length - 1];\n\nreturn [{\n  json: {\n    airtable_record_id,\n    has_booking: true,\n    calendly_uuid,\n    cancellation_reason,\n    skip_cancel: false,\n    cancelUrl\n  }\n}];"},"id":"ef952250-0026-44d6-8b9c-e9957f30f981","name":"Extract Calendly UUID","type":"n8n-nodes-base.code","typeVersion":2,"position":[672,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"cond-001","leftValue":"={{ $json.skip_cancel }}","rightValue":true,"operator":{"type":"boolean","operation":"false","singleValue":true}}],"combinator":"and"},"options":{}},"id":"6c4d1417-d856-48e6-ac42-02990a07d50f","name":"IF has_booking","type":"n8n-nodes-base.if","typeVersion":2,"position":[896,0]},{"parameters":{"method":"POST","url":"=https://api.calendly.com/scheduled_events/{{ $json.calendly_uuid }}/cancellation","authentication":"***REDACTED***","nodeCredentialType":"calendlyApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"reason\": {{ JSON.stringify($json.cancellation_reason || 'Cancelado via assistente AI') }}\n}","options":{}},"id":"7e5a780b-4e87-4b6a-9e01-0db8d58d3d46","name":"Cancel Calendly Event","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1120,-80],"credentials":null},{"parameters":{"assignments":{"assignments":[{"id":"n1","name":"success","value":"={{ true }}","type":"boolean"},{"id":"n2","name":"was_cancelled","value":"={{ false }}","type":"boolean"},{"id":"n3","name":"airtable_record_id","value":"={{ $('Extract Calendly UUID').item.json.airtable_record_id }}","type":"string"},{"id":"n4","name":"calendly_uuid","value":"","type":"string"},{"id":"n5","name":"cancellation_reason","value":"={{ $('Extract Calendly UUID').item.json.cancellation_reason }}","type":"string"},{"id":"n6","name":"message","value":"=Lead nao tinha booking ativo. Nenhuma acao foi necessaria.","type":"string"}]},"options":{}},"id":"b58ae569-3d92-4fe5-b439-1c4c94efe0c4","name":"Format Output (No Booking)","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[1120,120]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"a11d2a90-3b54-482d-9677-59ca5cf63c8c","leftValue":"={{ $json.error.description }}","rightValue":"Event in the past","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"id":"66029022-611b-44f1-af72-d072132c5042","name":"IF Event in the past","type":"n8n-nodes-base.if","typeVersion":3,"position":[1344,-80]},{"parameters":{"method":"PATCH","url":"=https://api.airtable.com/v0/appeFkj0KrO6svhbt/tblcMxt4kltZgTSjM/{{ $('Extract Calendly UUID').item.json.airtable_record_id }}","authentication":"***REDACTED***","nodeCredentialType":"airtableTokenApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"fields\": {\n    \"calendly_cancel_url\": \"\",\n    \"calendly_reschedule_url\": \"\"\n  }\n}","options":{}},"id":"0e5e21f7-96ab-4a19-b426-24738d491981","name":"Clear Airtable Fields2","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1568,-160],"credentials":null},{"parameters":{"method":"PATCH","url":"=https://api.airtable.com/v0/