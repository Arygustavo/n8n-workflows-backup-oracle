,"value":"eDNdO4Bx220K7DM9","mode":"id","cachedResultUrl":"/workflow/eDNdO4Bx220K7DM9"},"workflowInputs":{"mappingMode":"defineBelow","value":{"context":"Error debugging Make n8n workflow automation","project":"Ops","importance":"2"},"matchingColumns":[],"schema":[{"id":"context","displayName":"context","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"},{"id":"project","displayName":"project","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"},{"id":"importance","displayName":"importance","required":false,"defaultMatch":false,"display":true,"canBeUsedToMatch":true,"type":"string"}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{}},"id":"8e7d2af0-18d0-44a1-a35f-60139897cd45","name":"Memory Read","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[1016,-160],"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const data = $('Extract Error Data').item.json;\nconst memoryContext = $('Memory Read').first().json.memoryContext || 'Nenhuma memoria recente.';\n\nconst prompt = `Voce e o n8n-doctor. Um workflow n8n falhou e precisa de diagnostico.\n\nLe a skill em /home/claude/.claude/skills/n8n-doctor/SKILL.md para contexto.\n\n${memoryContext}\n\nNOTA SOBRE MEMORIA CRUZADA: Algumas memorias podem ser de outras instancias n8n (Hetzner, Railway, Oracle). Avalia relevancia cruzada antes de aplicar:\n- Transferiveis: erros de infraestrutura partilhada (Supabase, Anthropic API, OpenAI API, Evolution API, Chatwoot, Airtable), erros de logica de workflow, padroes de design, bugs de nodes nativos n8n.\n- NAO transferiveis: IDs de credentials especificos de cada instancia, IDs de workflow/sub-workflow (ApIb..., URJf..., etc.), URLs de webhook, paths locais (/home/claude/...), env vars especificas, problemas de network ligados ao IP do host.\n- Se a memoria menciona uma instancia diferente da actual e o erro e do tipo NAO transferivel, ignora essa memoria. Se e do tipo transferivel, usa-a com peso reduzido (e padrao, nao prova).\n\nERRO DETECTADO:\nWorkflow: ${data.workflow_name} (ID: ${data.workflow_id})\nNode: ${data.failed_node}\nError: ${data.error_message}\nExecution ID: ${data.execution_id}\n\nINSTANCIA: n8n-oracle (workflowsoracle.coletiv.me)\n\nTAREFAS:\n1. DIAGNOSTICA o erro — identifica root cause provavel\n2. CLASSIFICA severidade: CRITICO (servico down) | WARNING (degradado) | INFO (nao impactante)\n3. CLASSIFICA tipo: TRANSIENT (timeout, connection, rate limit) | PERSISTENT (config, dados, API changed)\n4. SUGERE fix concreto (comando, configuracao, ou accao manual)\n5. Se possivel, indica se e erro recorrente (padrao conhecido do n8n-doctor)\n6. Se a memoria recente mostra este MESMO erro ou workflow repetido: ESCALA severidade e sugere fix definitivo\n\nFORMATO DE RESPOSTA (maximo 200 palavras, directo, sem fluff):\n\nSeveridade: [CRITICO | WARNING | INFO]\nTipo: [TRANSIENT | PERSISTENT]\nAuto-fix: [SIM | NAO]\n\nRoot Cause:\n[1-2 frases]\n\nFix Sugerido:\n[passos concretos]\n\nAccao Necessaria:\n[automatico / manual / monitorar]`;\n\nreturn [{ json: { prompt, timeout: 90000, workflow_id: data.workflow_id, error_message: data.error_message } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1208,-160],"id":"4b13dd7e-1efb-4a41-81b8-943bf61245c3","name":"Build Diagnostic Prompt + Memory"},{"parameters":{"method":"POST","url":"https://macmini-bridge.coletiv.me/execute","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"***REDACTED***"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"prompt","value":"={{ $json.prompt }}"},{"name":"timeout","value":"={{ $json.timeout }}"}]},"options":{}},"id":"6928800b-d686-4eb4-b44d-53ee560dab12","name":"Claude Bridge","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1432,-160],"retryOnFail":true,"maxTries":2,"waitBetweenTries":5000,"onError":"continueRegularOutput"},{"parameters":{"chatId":"-