son.identifier.replace(/\"/g, '\\\\\"') + '\"' }}","returnAll":false,"limit":1,"options":{}},"id":"at-search","name":"Airtable - Search Lead","type":"n8n-nodes-base.airtable","typeVersion":2.1,"position":[256,-64],"credentials":null},{"parameters":{"jsCode":"const searchResults = $input.all();\nconst norm = $('Normalize Payload').first().json;\n\nconst utmFields = {\n  utm_source: norm.utm_source,\n  utm_campaign: norm.utm_campaign,\n  utm_medium: norm.utm_medium,\n  utm_term: norm.utm_term,\n  utm_content: norm.utm_content,\n};\n\nif (searchResults.length > 0 && searchResults[0].json && searchResults[0].json.id) {\n  // Lead found: build UPDATE payload with FIRST-TOUCH attribution\n  const existing = searchResults[0].json.fields || {};\n  const recordId = searchResults[0].json.id;\n  const updateFields = {};\n  const ***REDACTED*** = [];\n\n  for (const [key, val] of Object.entries(utmFields)) {\n    if (!val) continue;\n    const currentValue = (existing[key] || '').toString().trim();\n    if (currentValue === '') {\n      updateFields[key] = val;\n    } else {\n      ***REDACTED***.push({ field: key, existing: currentValue, incoming: val });\n    }\n  }\n\n  return [{ json: {\n    mode: 'update',\n    record_id: recordId,\n    fields: updateFields,\n    skipped: ***REDACTED***,\n    would_change: Object.keys(updateFields).length > 0,\n  } }];\n}\n\n// Lead not found: build CREATE payload\nconst createFields = {};\n\n// Primary identifier field\nif (norm.identifier_type === 'email' && norm.identifier) {\n  createFields.email = norm.identifier;\n} else if (norm.identifier_type === 'whatsapp' && norm.identifier) {\n  createFields.phone = norm.identifier;\n} else if (norm.identifier) {\n  // default: instagram\n  createFields.igName = norm.identifier;\n}\n\n// Secondary identifiers (if provided in optional payload keys)\nif (norm.lead_name)    createFields.name    = norm.lead_name;\nif (norm.lead_email    && !createFields.email)    createFields.email    = norm.lead_email;\nif (norm.lead_phone    && !createFields.phone)    createFields.phone    = norm.lead_phone;\nif (norm.lead_igName   && !createFields.igName)   createFields.igName   = norm.lead_igName;\nif (norm.lead_language) createFields.language = norm.lead_language;\nif (norm.lead_cliente)  createFields.cliente  = norm.lead_cliente;\n\nfor (const [key, val] of Object.entries(utmFields)) {\n  if (val) createFields[key] = val;\n}\n\nreturn [{ json: {\n  mode: 'create',\n  record_id: null,\n  fields: createFields,\n  skipped: [],\n  would_change: Object.keys(createFields).length > 0,\n} }];"},"id":"prep-1","name":"Prepare Upsert","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,-64]},{"parameters":{"rules":{"values":[{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"sw-update","leftValue":"={{ $json.mode }}","rightValue":"update","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"update"},{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"sw-create","leftValue":"={{ $json.mode }}","rightValue":"create","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"renameOutput":true,"outputKey":"create"}]},"options":{}},"id":"sw-mode","name":"Mode Switch","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[640,-64]},{"parameters":{"assignments":{"assignments":[{"id":"f-id","name":"id","value":"={{ $json.record_id }}","type":"string"},{"id":"f-src","name":"utm_source","value":"={{ $json.fields.utm_source || '' }}","type":"string"},{"id":"f-camp","name":"utm_campaign","value":"={{ $json.fields.utm_campaign || '' }}","type":"string"},{"id":"f-med","name":"utm_medium","value":"={{ $json.fields.utm_medium || '' }}","type":"string"},{"id":"f-term","name":"utm_term","value":"={{ $json.fields.utm_