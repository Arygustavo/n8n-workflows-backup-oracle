{"updatedAt":"2026-07-11T15:46:08.597Z","createdAt":"2026-07-11T15:46:08.597Z","id":"XviTdwSS2dqkZY4E","name":"[Sub Tool] save_user_data (CLImob)","active":false,"isArchived":false,"nodes":[{"parameters":{},"id":"2f7f6474-4e35-474e-a4ff-8198d3a53134","name":"Execute Workflow Trigger","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[0,0]},{"parameters":{},"id":"e7ce9456-75e3-4628-890e-6c9719cb0886","name":"When clicking 'Test'","type":"n8n-nodes-base.manualTrigger","typeVersion":1,"position":[0,304]},{"parameters":{"assignments":{"assignments":[{"id":"a1","name":"airtable_record_id","value":"recXXXXXXXXXXXXXX","type":"string"},{"id":"a2","name":"Obs","value":"Teste resposta do sub-tool save_user_data (CLImob)","type":"string"},{"id":"a3","name":"tags","value":"={{ ['Conversa Finalizada'] }}","type":"array"},{"id":"a4","name":"off_Bot","value":"={{ false }}","type":"boolean"}]},"options":{}},"id":"c0a28ada-5027-4952-b2ee-66794bf48cc3","name":"Set Test Input","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[224,304]},{"parameters":{"jsCode":"const input = $input.item.json;\n\nconst recordId = input.airtable_record_id;\nif (!recordId) {\n  throw new Error('airtable_record_id is required');\n}\n\n// Passthrough generico: escreve qualquer campo enviado pelo chamador, usando o\n// MESMO nome de coluna do Airtable. Nao ha fieldMap fixo (ao contrario do sub-tool\n// Autobot original) porque a tabela Leads do CLImob (Real Estate Listings Manager)\n// nao tem os campos resposta1-6/lead_Report/Enviar Proposta? do schema Autobot —\n// tem: Obs, Proposal, Rating, off_Bot, tags, Notas, entre outros.\nconst RESERVED = new Set(['airtable_record_id']);\nconst fields = {};\nfor (const [key, value] of Object.entries(input)) {\n  if (RESERVED.has(key)) continue;\n  if (value !== null && value !== undefined && value !== '') {\n    fields[key] = value;\n  }\n}\n\nif (Object.keys(fields).length === 0) {\n  throw new Error('No fields to update');\n}\n\nreturn [{\n  json: {\n    airtable_record_id: recordId,\n    fields: fields,\n    fields_updated_count: Object.keys(fields).length,\n    fields_updated_list: Object.keys(fields)\n  }\n}];"},"id":"50e82988-4ef8-4019-b733-2a877b4cea0c","name":"Build Update Object","type":"n8n-nodes-base.code","typeVersion":2,"position":[448,160]},{"parameters":{"method":"PATCH","url":"=https://api.airtable.com/v0/appeFkj0KrO6svhbt/tblcMxt4kltZgTSjM/{{ $json.airtable_record_id }}","authentication":"***REDACTED***","nodeCredentialType":"airtableTokenApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ fields: $json.fields }) }}","options":{}},"id":"5fa7aa59-68f0-4553-845b-2830eff8ff98","name":"Airtable - Update Record","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[672,160],"credentials":null},{"parameters":{"assignments":{"assignments":[{"id":"f1","name":"success","value":"={{ true }}","type":"boolean"},{"id":"f2","name":"airtable_record_id","value":"={{ $('Build Update Object').item.json.airtable_record_id }}","type":"string"},{"id":"f3","name":"fields_updated_count","value":"={{ $('Build Update Object').item.json.fields_updated_count }}","type":"number"},{"id":"f4","name":"fields_updated_list","value":"={{ $('Build Update Object').item.json.fields_updated_list }}","type":"array"},{"id":"f5","name":"message","value":"=Lead atualizado com sucesso. {{ $('Build Update Object').item.json.fields_updated_count }} campo(s) modificado(s).","type":"string"}]},"options":{}},"id":"be624e44-1650-4706-af61-c2d240177b48","name":"Format Output","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[880,160]}],"connections":{"Execute Workflow Trigger":{"main":[[{"node":"Build Update Object","type":"main","index":0}]]},"When clicking 'Test'":{"main":[[{"node":"Set Test Input","type":"main","index":0}]]},"Set Test Input":{"main":[[{"node":"Build Update Object","type":"main","index":0}]]},"Build Update Object":{"main":[[{"node":"Airtable - Update Record","type":"